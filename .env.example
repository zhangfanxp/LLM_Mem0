# NVIDIA API key from build.nvidia.com
NVIDIA_API_KEY=

# Mem0 Platform API key from app.mem0.ai
MEM0_API_KEY=

# Cloudflare Workers AI credentials (Workers AI Read permission)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional overrides
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# The default Nemotron setting favors lower latency; use high for more deliberation.
NVIDIA_REASONING_EFFORT=low
MEM0_USER_ID=personal-assistant
PORT=5001

# Optional Microsoft Edge online voice (default is Mandarin Xiaoxiao)
TTS_VOICE=zh-CN-XiaoxiaoNeural
